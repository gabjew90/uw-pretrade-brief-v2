# v3 REUSES v2's API keys — same env var names. Copy to .env and fill from your
# existing keys (or set them in the deploy env). NEVER commit real values.

# Unusual Whales (Basic tier or higher) — REQUIRED for live fetches
UW_API_KEY=

# Google Gemini — optional; insights fall back to deterministic rules without it
GEMINI_API_KEY=

# Token that unlocks /admin/* (export/backfill) + scripts/pull_archive.py
BACKFILL_TOKEN=

# Railway account token (for `railway run` / deploys). Reused from v2.
RAILWAY_API_TOKEN=

# Where the parquet archive lives (bronze/silver/gold partitions + duckdb).
DATA_DIR=./data

# Offline mode — serve the captured bronze archive, never call UW.
# REPLAY=1

# Optional: comma-separated tickers always tracked regardless of flow rank
TICKER_PIN_LIST=AAPL,NVDA,TSLA,MSFT,GOOGL

# UW budget guard (defaults shown; daily cap overridden by UW response headers).
# UW_DAILY_CAP=15000
# UW_BUDGET_SOFT_PCT=0.9

LOG_LEVEL=INFO
