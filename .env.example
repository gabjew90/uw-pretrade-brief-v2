# Unusual Whales (Basic tier or higher)
UW_API_KEY=

# Google Gemini (Flash-Lite model)
GEMINI_API_KEY=

# Where to write the parquet archive + snapshots.jsonl
DATA_DIR=/data

# Optional: regime banner copy (operator-set; no live VIX endpoint on UW Basic)
REGIME=normal
REGIME_DETAIL_TEXT=VIX 18.4 · FOMC in 6 days · structural bets favored

# Optional: comma-separated tickers always tracked regardless of flow rank
TICKER_PIN_LIST=AAPL,NVDA,TSLA,MSFT,GOOGL

# Logging
LOG_LEVEL=INFO
