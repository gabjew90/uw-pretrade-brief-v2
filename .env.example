# Unusual Whales (Basic tier or higher) — REQUIRED
UW_API_KEY=

# Google Gemini (Flash-Lite model) — optional; insights fall back to deterministic rules without it
GEMINI_API_KEY=

# Where to write the parquet archive + snapshots.jsonl
DATA_DIR=/data

# Optional: comma-separated tickers always tracked regardless of flow rank
TICKER_PIN_LIST=AAPL,NVDA,TSLA,MSFT,GOOGL

# Optional: manual override for the regime label (normal | risk-off).
# The old REGIME_DETAIL_TEXT banner is superseded by the computed market-regime header.
REGIME=normal

# Optional: token that unlocks /admin/backfill + /admin/export (and scripts/pull_archive.py)
BACKFILL_TOKEN=

# Optional: offline mode — serve the captured archive, never call UW (see README "Local replay")
# REPLAY=1

# Optional: UW budget guard (defaults shown). Daily cap is overridden by UW response headers when present.
# UW_DAILY_CAP=15000
# UW_BUDGET_SOFT_PCT=0.9

# Optional kill-switches
# SNAPSHOT_PAUSED=1        # pause the background loop's UW calls
# MARKET_GATE_DISABLED=1   # ignore market-hours gating

# Logging
LOG_LEVEL=INFO
